diff --git a/src/posix/fs.cpp b/src/posix/fs.cpp
index a3b87c6..6084144 100644
--- a/src/posix/fs.cpp
+++ b/src/posix/fs.cpp
@@ -2081,10 +2081,12 @@ ScanResult PosixFileSystemAccess::directoryScan(const LocalPath& targetPath,
     auto device = metadata.st_dev;
 
     // Iterate over the directory's children.
-    auto entry = readdir(directory);
+    // readdir() returns NULL at the end and on an error: only errno tells them apart.
     auto path = targetPath;
+    errno = 0;
+    auto entry = readdir(directory);
 
-    for ( ; entry; entry = readdir(directory))
+    for ( ; entry; errno = 0, entry = readdir(directory))
     {
         // Skip special hardlinks.
         if (!strcmp(entry->d_name, "."))
@@ -2214,9 +2216,26 @@ ScanResult PosixFileSystemAccess::directoryScan(const LocalPath& targetPath,
         ++nFingerprinted;
     }
 
+    // Latch error.
+    auto error = errno;
+
     // We're done iterating the directory.
     closedir(directory);
 
+    // A partial listing must not be taken as the folder's content:
+    // the missing entries would count as deleted.
+    if (error)
+    {
+        LOG_warn << "Failed to directoryScan: "
+                 << "Unable to list scan target: "
+                 << targetPath
+                 << ". Error code was: "
+                 << error;
+
+        results.clear();
+        return SCAN_INACCESSIBLE;
+    }
+
     return SCAN_SUCCESS;
 }
 
