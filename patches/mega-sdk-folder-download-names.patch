+namespace
+{
+std::atomic<std::string (*)(const std::string&)> folderDownloadNameFilter{nullptr};
+
+// The local name of a file or folder inside a folder download
+std::string folderDownloadName(const char* name)
+{
+    std::string result = name ? name : "";
+    auto filter = folderDownloadNameFilter.load();
+    return filter ? filter(result) : result;
+}
+}
+
+void setFolderDownloadNameFilter(std::string (*filter)(const std::string& name))
+{
+    folderDownloadNameFilter = filter;
+}
